        let galleryInterval;
        let currentIndex = 0;
        let currentSpeed = 2500; 
        let isPaused = false;
        
        let currentDrawMode = 'extraction';
        window.currentRootUrl = "";

        const preloadedCache = {
            circle: { elements: [], remainingUrls: [] },
            triangle: { elements: [], remainingUrls: [] },
            square: { elements: [], remainingUrls: [] }
        };

        window.shuffleArray = function(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]]; 
            }
            return array;
        };

        function loadRemainingImagesSequentially(shape) {
            const urls = preloadedCache[shape].remainingUrls;
            let index = 0;

            function loadNext() {
                if (index >= urls.length) return;

                const url = urls[index];
                const img = new Image();
                img.src = url;
                img.crossOrigin = "anonymous";
                img.decoding = "async";
                img.className = 'photo-layer';
                // [복구] 갤러리 이미지 클릭 시 추출 모드로 진입
                img.onclick = () => window.openDrawing(url, "", 'extraction');
                
                img.onload = () => {
                    const container = document.getElementById('photo-container');
                    if (document.getElementById('gallery-screen').classList.contains('active')) {
                        container.appendChild(img);
                    }
                    preloadedCache[shape].elements.push(img);
                    
                    index++;
                    loadNext(); 
                };
                
                img.onerror = () => {
                    index++;
                    loadNext();
                };
            }

            loadNext();
        }

        function initPreload() {
            ['circle', 'triangle', 'square'].forEach(shape => {
                const allUrls = window.shuffleArray([...imgData[shape]]);
                
                const firstBatch = allUrls.slice(0, 1);
                const remaining = allUrls.slice(1);
                
                preloadedCache[shape].remainingUrls = remaining;

                firstBatch.forEach(url => {
                    const img = new Image();
                    img.src = url;
                    img.crossOrigin = "anonymous";
                    img.decoding = "async";
                    img.className = 'photo-layer';
                    img.onclick = () => window.openDrawing(url, "", 'extraction');
                    preloadedCache[shape].elements.push(img);
                });
            });
        }

        initPreload();

        // 뷰파인더 셔플
        function startShuffle(shape) {
            const imgEl = document.getElementById(`img-${shape}`);
            const images = imgData[shape];
            imgEl.style.backgroundImage = `url(${images[Math.floor(Math.random() * images.length)]})`;
            
            window[`shuffle_${shape}`] = setInterval(() => {
                const randomUrl = images[Math.floor(Math.random() * images.length)];
                imgEl.style.backgroundImage = `url(${randomUrl})`;
            }, 150); 
        }

        function stopShuffle(shape) {
            if (window[`shuffle_${shape}`]) {
                clearInterval(window[`shuffle_${shape}`]);
            }
        }

        ['circle', 'triangle', 'square'].forEach(shape => {
            const btn = document.getElementById(`vf-${shape}`);
            const imgEl = document.getElementById(`img-${shape}`);
            imgEl.style.backgroundImage = `url(${imgData[shape][Math.floor(Math.random() * imgData[shape].length)]})`;

            btn.addEventListener('mouseenter', () => startShuffle(shape));
            btn.addEventListener('mouseleave', () => stopShuffle(shape));
        });

        // 배경에 아카이브 이미지 로드
        async function loadBackgroundImages() {
            const bgLayer = document.getElementById('main-bg-layer');
            try {
                const q = window.query(window.collection(window.db, "gazes"), window.orderBy("createdAt", "desc"), window.limit(30));
                const querySnapshot = await window.getDocs(q);
                
                if (querySnapshot.empty) {
                    return;
                }

                querySnapshot.forEach((docSnap) => {
                    const data = docSnap.data();
                    const img = document.createElement('img');
                    img.src = data.imageUrl; // 사람들이 그린 그림
                    img.className = 'bg-trace-item';
                    img.loading = "lazy";
                    bgLayer.appendChild(img);
                });
            } catch (e) {
                console.error("BG Load Error:", e);
            }
        }
        
        loadBackgroundImages();

        window.openHelp = function() {
            const modal = document.getElementById('help-modal');
            modal.style.display = 'flex';
            setTimeout(() => modal.classList.add('show'), 10);
        };
        window.closeHelp = function() {
            const modal = document.getElementById('help-modal');
            modal.classList.remove('show');
            setTimeout(() => modal.style.display = 'none', 300);
        };

        // [복구] 갤러리 열기 함수 정상화
        window.openGallery = function(shape) {
            document.getElementById('main-screen').style.opacity = '0';
            document.getElementById('main-screen').style.pointerEvents = 'none';
            document.getElementById('gallery-screen').classList.add('active');

            const container = document.getElementById('photo-container');
            container.innerHTML = '';

            const preloadedImgs = preloadedCache[shape].elements;
            preloadedImgs.forEach(img => {
                container.appendChild(img);
            });

            if(preloadedImgs.length > 0) {
                currentIndex = 0;
                preloadedImgs[0].classList.add('visible');
            }

            window.startSlideShow();

            if (preloadedCache[shape].remainingUrls.length > 0 && preloadedCache[shape].elements.length < 2) {
                loadRemainingImagesSequentially(shape);
            }
        };

        window.startSlideShow = function() {
            if(galleryInterval) clearInterval(galleryInterval);
            isPaused = false;
            
            galleryInterval = setInterval(() => {
                const container = document.getElementById('photo-container');
                const imgs = container.getElementsByClassName('photo-layer');
                
                if (imgs.length <= 1) return;

                if(imgs[currentIndex]) imgs[currentIndex].classList.remove('visible');
                currentIndex = (currentIndex + 1) % imgs.length;
                
                if(imgs[currentIndex]) {
                    imgs[currentIndex].classList.add('visible');
                }
            }, currentSpeed);
        };

        window.goMain = function() {
            if(galleryInterval) clearInterval(galleryInterval);
            document.getElementById('gallery-screen').classList.remove('active');
            document.getElementById('main-screen').style.opacity = '1';
            document.getElementById('main-screen').style.pointerEvents = 'all';
        };

        window.startRandomGame = function() {
            window.closeArchive();
            const allImages = [
                ...imgData.circle,
                ...imgData.triangle,
                ...imgData.square
            ];
            const randomImg = allImages[Math.floor(Math.random() * allImages.length)];
            window.openDrawing(randomImg, "", 'extraction');
        };

        window.openDrawing = function(imageUrl, existingTitle = "", mode = 'extraction', rootUrl = "") {
            if(galleryInterval) clearInterval(galleryInterval);
            
            currentDrawMode = mode;
            window.currentRootUrl = rootUrl;

            document.getElementById('drawing-screen').classList.add('show');
            const bgImg = document.getElementById('drawing-bg');
            bgImg.crossOrigin = "anonymous";
            bgImg.decoding = "async";
            bgImg.src = imageUrl;
            
            resizeCanvas();
            const canvas = document.getElementById('drawing-canvas');
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            window.drawingHistory = [];
            saveState(); 

            const defaultColor = '#000000';
            document.getElementById('color-picker').value = defaultColor;

            const titleInput = document.getElementById('drawing-title');
            const titleWrapper = document.getElementById('title-container-wrapper');

            if (mode === 'extraction') {
                titleWrapper.style.display = 'none';
                titleInput.value = ""; 
            } else {
                titleWrapper.style.display = 'flex';
                titleInput.value = ""; 
                titleInput.placeholder = existingTitle ? `Orig: ${existingTitle}` : "제목을 입력하세요";
            }
        };

        window.closeDrawing = function() {
            document.getElementById('drawing-screen').classList.remove('show');
            // [수정] 갤러리 화면이 활성화된 상태라면(추출 모드) -> 갤러리 화면 유지 및 슬라이드 재개
            if(document.getElementById('gallery-screen').classList.contains('active')) {
                window.startSlideShow();
            } else {
                // 셰이프 게임 모드 등 다른 경우 -> 아카이브 열기 (혹은 메인으로 갈 수도 있음)
                window.openArchive();
            }
        };

        window.setTool = function(tool) {
            window.currentTool = tool;
            document.getElementById('btn-brush').classList.remove('active');
            document.getElementById('btn-eraser').classList.remove('active');
            if(tool === 'brush') document.getElementById('btn-brush').classList.add('active');
            else document.getElementById('btn-eraser').classList.add('active');
        };
        
        window.undo = function() {
            const canvas = document.getElementById('drawing-canvas');
            const ctx = canvas.getContext('2d');
            if (window.drawingHistory.length === 0) { ctx.clearRect(0, 0, canvas.width, canvas.height); return; }
            const prevUrl = window.drawingHistory.pop();
            const img = new Image();
            img.src = prevUrl;
            img.onload = () => { ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.globalCompositeOperation = 'source-over'; ctx.drawImage(img, 0, 0); if(window.currentTool === 'eraser') ctx.globalCompositeOperation = 'destination-out'; };
        };

        window.saveAndArchive = async function() {
            if (!confirm("저장하시겠습니까?")) {
                return;
            }

            let title = "";
            if (currentDrawMode === 'shapegame') {
                const titleInput = document.getElementById('drawing-title');
                title = titleInput.value.trim();
            }

            const canvas = document.getElementById('drawing-canvas');
            let finalDataUrl = "";
            
            if (currentDrawMode === 'shapegame') {
                const tempCanvas = document.createElement('canvas');
                tempCanvas.width = canvas.width;
                tempCanvas.height = canvas.height;
                const tCtx = tempCanvas.getContext('2d');
                
                const bgImg = document.getElementById('drawing-bg');
                
                const imgRatio = bgImg.naturalWidth / bgImg.naturalHeight;
                const canvasRatio = canvas.width / canvas.height;
                let drawW, drawH, drawX, drawY;

                if (imgRatio > canvasRatio) {
                    drawW = canvas.width;
                    drawH = drawW / imgRatio;
                    drawX = 0;
                    drawY = (canvas.height - drawH) / 2;
                } else {
                    drawH = canvas.height;
                    drawW = drawH * imgRatio;
                    drawX = (canvas.width - drawW) / 2;
                    drawY = 0;
                }
                
                tCtx.drawImage(bgImg, drawX, drawY, drawW, drawH);
                tCtx.drawImage(canvas, 0, 0);
                
                finalDataUrl = tempCanvas.toDataURL("image/png");
            } else {
                finalDataUrl = canvas.toDataURL("image/png");
            }
            
            let finalOriginalUrl = "";
            if (currentDrawMode === 'shapegame') {
                finalOriginalUrl = window.currentRootUrl || document.getElementById('drawing-bg').src;
            } else {
                finalOriginalUrl = document.getElementById('drawing-bg').src;
            }

            try {
                await window.addDoc(window.collection(window.db, "gazes"), { 
                    imageUrl: finalDataUrl, 
                    title: title, 
                    originalBgUrl: finalOriginalUrl, 
                    createdAt: Date.now() 
                });

                showToast("저장 완료");
                window.closeDrawing(); 

            } catch (e) {
                console.error("Save Error: ", e);
                alert("저장에 실패했습니다.");
            }
        };

        function showToast(message) {
            const toast = document.getElementById('toast-message');
            toast.innerText = message;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2000);
        }

        window.deleteGaze = async function(event, docId) {
            event.stopPropagation();
            if(confirm("정말로 이 기록을 삭제하시겠습니까?")) {
                try {
                    await window.deleteDoc(window.doc(window.db, "gazes", docId));
                    alert("삭제되었습니다.");
                    window.openArchive();
                } catch(e) {
                    console.error("Delete Error: ", e);
                    alert("삭제에 실패했습니다.");
                }
            }
        };

        window.openViewModal = function(data) {
            const modal = document.getElementById('view-modal');
            const drawingLayer = document.getElementById('view-drawing-layer');
            const backdropLayer = document.getElementById('view-backdrop-layer');
            const titleEl = document.getElementById('view-title');
            const dateEl = document.getElementById('view-date');
            const originalBtn = document.getElementById('view-original-btn');

            drawingLayer.src = data.imageUrl; 
            titleEl.innerText = data.title ? data.title : '무제';
            
            const d = new Date(data.createdAt);
            dateEl.innerText = d.getFullYear() + '.' + (d.getMonth()+1) + '.' + d.getDate();

            if (data.originalBgUrl) {
                originalBtn.style.display = 'flex';
                backdropLayer.src = data.originalBgUrl; 
                
                let isOverlayActive = false;
                
                originalBtn.onclick = () => {
                    isOverlayActive = !isOverlayActive;
                    if (isOverlayActive) {
                        backdropLayer.style.opacity = '0.5'; 
                        originalBtn.classList.add('active');
                    } else {
                        backdropLayer.style.opacity = '0';
                        originalBtn.classList.remove('active');
                    }
                };
                
                isOverlayActive = false;
                backdropLayer.style.opacity = '0';
                originalBtn.classList.remove('active');

            } else {
                originalBtn.style.display = 'none';
                originalBtn.onclick = null;
            }

            modal.style.display = 'flex';
            setTimeout(() => modal.classList.add('show'), 10);
        };

        window.closeView = function() {
            const modal = document.getElementById('view-modal');
            modal.classList.remove('show');
            setTimeout(() => modal.style.display = 'none', 300);
            window.openArchive();
        };

        window.openArchive = async function() {
            const archiveScreen = document.getElementById('archive-screen');
            const grid = document.getElementById('archive-grid');
            
            document.getElementById('main-screen').style.opacity = '0';
            document.getElementById('main-screen').style.pointerEvents = 'none';
            archiveScreen.classList.add('active');
            
            grid.innerHTML = '<div class="archive-loading">기록된 시선들을 불러옵니다...</div>';

            try {
                const q = window.query(window.collection(window.db, "gazes"), window.orderBy("createdAt", "desc"), window.limit(50));
                const querySnapshot = await window.getDocs(q);
                
                grid.innerHTML = ''; 
                if (querySnapshot.empty) { 
                    grid.innerHTML = '<div style="color:#666; text-align:center;">아직 기록이 없습니다.<br>시선 담기 버튼을 눌러보세요!</div>'; 
                    return; 
                }

                querySnapshot.forEach((docSnap) => {
                    const data = docSnap.data();
                    const docId = docSnap.id;
                    
                    const hasTitle = data.title && data.title.trim() !== "";

                    const item = document.createElement('div');
                    item.className = 'archive-item';
                    
                    if (!hasTitle) item.classList.add('playable');
                    
                    item.onclick = () => {
                        document.getElementById('archive-screen').classList.remove('active');
                        
                        if (hasTitle) {
                            window.openViewModal(data);
                        } else {
                            setTimeout(() => {
                                window.openDrawing(data.imageUrl, "", 'shapegame', data.originalBgUrl); 
                            }, 300);
                        }
                    };

                    const deleteBtn = document.createElement('button');
                    deleteBtn.className = 'delete-btn';
                    deleteBtn.innerHTML = '×';
                    deleteBtn.onclick = (e) => window.deleteGaze(e, docId);
                    item.appendChild(deleteBtn);

                    const imgWrapper = document.createElement('div');
                    imgWrapper.className = 'archive-img-wrapper';
                    const img = document.createElement('img');
                    img.src = data.imageUrl;
                    img.className = 'archive-img';
                    imgWrapper.appendChild(img);

                    const titleDiv = document.createElement('div');
                    titleDiv.className = 'archive-item-title';
                    
                    titleDiv.innerText = hasTitle ? data.title : '이어그리기';
                    
                    item.appendChild(imgWrapper);
                    item.appendChild(titleDiv);
                    grid.appendChild(item);
                });

            } catch (e) { 
                console.error("Error getting documents: ", e); 
                grid.innerHTML = '<div style="color:red; text-align:center;">데이터 로드 실패</div>'; 
            }
        };
        
        window.closeArchive = function() {
            document.getElementById('archive-screen').classList.remove('active');
            document.getElementById('main-screen').style.opacity = '1';
            document.getElementById('main-screen').style.pointerEvents = 'all';
        };

        const speedSlider = document.getElementById('speed-slider');
        currentSpeed = 10000 - parseInt(speedSlider.value); 

        speedSlider.addEventListener('input', function(e) {
            currentSpeed = 10000 - parseInt(e.target.value);
            if(document.getElementById('gallery-screen').classList.contains('active') && !isPaused) {
                window.startSlideShow();
            }
        });

        const canvas = document.getElementById('drawing-canvas');
        const ctx = canvas.getContext('2d');
        window.isDrawing = false;
        window.drawingHistory = [];
        window.currentTool = 'brush';
        
        function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeCanvas);
        
        function startDraw(e) { if (e.type !== 'mousedown') return; saveState(); window.isDrawing = true; ctx.beginPath(); ctx.moveTo(e.clientX, e.clientY); }
        function draw(e) { if (!window.isDrawing) return; const color = document.getElementById('color-picker').value; const size = document.getElementById('brush-size').value; ctx.lineWidth = size; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; if (window.currentTool === 'eraser') { ctx.globalCompositeOperation = 'destination-out'; ctx.strokeStyle = 'rgba(0,0,0,1)'; } else { ctx.globalCompositeOperation = 'source-over'; ctx.strokeStyle = color; } ctx.lineTo(e.clientX, e.clientY); ctx.stroke(); }
        function stopDraw() { if (window.isDrawing) { window.isDrawing = false; ctx.closePath(); } }
        function saveState() { if(window.drawingHistory.length > 20) window.drawingHistory.shift(); window.drawingHistory.push(canvas.toDataURL()); }
        
        canvas.addEventListener('mousedown', startDraw);
        canvas.addEventListener('mousemove', draw);
        canvas.addEventListener('mouseup', stopDraw);
        canvas.addEventListener('mouseleave', stopDraw);
        canvas.addEventListener('touchstart', (e) => { e.preventDefault(); const touch = e.touches[0]; const mouseEvent = new MouseEvent("mousedown", { clientX: touch.clientX, clientY: touch.clientY }); canvas.dispatchEvent(mouseEvent); }, {passive: false});
        canvas.addEventListener('touchmove', (e) => { e.preventDefault(); const touch = e.touches[0]; const mouseEvent = new MouseEvent("mousemove", { clientX: touch.clientX, clientY: touch.clientY }); canvas.dispatchEvent(mouseEvent); }, {passive: false});
        canvas.addEventListener('touchend', () => { const mouseEvent = new MouseEvent("mouseup", {}); canvas.dispatchEvent(mouseEvent); });
        
        document.addEventListener('keydown', function(e) {
            if (!document.getElementById('drawing-screen').classList.contains('show')) return;
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') { e.preventDefault(); window.undo(); }
        });
    </script>
</body>
